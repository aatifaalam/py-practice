class Solution(object):
    def isAnagram(self, s, t):
        sd = {}
        td = {}
        for i in range(len(s)):
            if s[i] not in sd:
                sd[s[i]] = 1
            else:
                sd[s[i]] += 1  
        for i in range(len(t)):
            if t[i] not in td:
                td[t[i]] = 1
            else:
                td[t[i]] += 1

        if sd == td:
            return True
        return False
    
a = Solution()
s = "anagrams"
t = "nagaram"
ans = a.isAnagram(s, t)
print(ans)
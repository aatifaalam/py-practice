from typing import List
class Solution:
    def rotate(self, nums: List[int], k: int) -> None:
        """
        Do not return anything, modify nums in-place instead.
        """
        count = 0
        while count < k:
            last = nums[len(nums) - 1]
            for i in range(len(nums) - 1, 0, -1):
                nums[i] = nums[i - 1]
            nums[0] = last
            count += 1
        return nums

a = Solution()
nums = [1,2,3,4,5]
k = 2
ans = a.rotate(nums, k)
print(ans)
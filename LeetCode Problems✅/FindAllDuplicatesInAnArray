from typing import List
class Solution:
    def findDuplicates(self, nums: List[int]) -> List[int]:

        freq = {}
        for num in nums:
            if num not in freq:
                freq[num] = 1
            else:
                freq[num] += 1

        ans = []
        for k, v in freq.items():
            if v > 1:
                ans.append(k)
        return ans

a = Solution()
nums = [4,3,2,7,8,2,3,1]
ans = a.findDuplicates(nums)
print(ans)
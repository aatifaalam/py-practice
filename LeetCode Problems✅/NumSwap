from typing import List

class Solution:
    def arrayChange(self, nums: List[int], i, j) -> List[int]:
        for i in range(len(nums)):
            for j in range(i+1, len(nums)):
                nums[i], nums[j] = nums[j], nums[i]
        return nums
a = Solution()
nums = [1,2,3,4]
i = 0
j = 1
ans = a.arrayChange(nums, i, j)
print(ans)
class Solution(object):
    def minimumOperations(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        # nums.sort()
        # count = 0
        # for i in range(len(nums)):
        #     if nums[i] != 0:
        #         minVal = min([x for x in nums if x > 0])
        #         for j in range(len(nums)):
        #             if nums[j] > 0:
        #                 nums[j] -= minVal
        #         count += 1
        # return count


        heap = [x for x in nums if x > 0]
        count = 0
        while heap:
            minVal = min(heap)
            heap = [x - minVal for x in heap if x - minVal > 0]
            count += 1
        return count
    
a = Solution()
nums = [1,5,0,3,5]
ans = a.minimumOperations(nums)
print(ans)
class Solution(object):
    def topKFrequent(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: List[int]
        """
        freq = {}
        for i in range(len(nums)):
            if nums[i] not in freq:
                freq[nums[i]] = 1
            else:
                freq[nums[i]] += 1
        ans = []
        for i in range(k):
            max_freq = max(freq.values())
            for key, value in freq.items():
                if value == max_freq:
                    ans.append(key)
                    del freq[key]
                    break
        return ans

a = Solution()
nums = [1,2,1,2,1,2,3,1,3,2]
k = 2
ans = a.topKFrequent(nums, k)
print(ans)
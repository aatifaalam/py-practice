from typing import List

class Solution:
    def arrayChange(self, nums: List[int], operations) -> List[int]:

        a_v = {}
        for i in range(len(nums)):
            a_v[nums[i]] = i


        for i in range(len(operations)):
            """
            """
            k = operations[i][0]
            v = operations[i][1]
            nums[a_v[k]] = v
            a_v[v] = a_v[k]
            a_v.pop(k)
        return nums

a = Solution()
nums = [1,2]
operations = [[1,3],[2,1],[3,2],[2,3]]
ans = a.arrayChange(nums, operations)
print(ans)
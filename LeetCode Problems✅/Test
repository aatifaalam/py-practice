from math import inf
class Solution(object):
    def maximumTripletValue(self, nums):
        maximum = -inf
        for j in range(1, len(nums)-1, 1):
            i = j-1
            while(i >= 0):            
                k = j+1
                while(k < len(nums)):
                    value = (nums[i] - nums[j]) * nums[k];
                    maximum = max(value, maximum)
                    k+=1
                i-=1
        return maximum
        

a = Solution()
nums = [12,6,1,2,7]
a.maximumTripletValue(nums)
class Solution(object):
    def missingNumber(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        nums.sort()
        for i in range(len(nums)):
            if nums[i] != i:
                return i
        return len(nums)    

a = Solution()
nums = [1,2,4,5]
ans = a.missingNumber(nums)
print(ans)
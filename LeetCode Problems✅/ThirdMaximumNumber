class Solution(object):
    def thirdMax(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        n = list(set(nums))
        if len(n) > 3:
            n.sort()
            return n[-3]
        elif len(n) == 2:
            return max(n)
        return min(n)
a = Solution()
nums = [-4,-5,-3,-2,-1]
ans = a.thirdMax(nums)
print(ans)
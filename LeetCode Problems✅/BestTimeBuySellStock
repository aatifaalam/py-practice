class Solution(object):
    def maxProfit(self, prices):
        """
        :type prices: List[int]
        :rtype: int
        """
        low = prices[0]
        maximum = 0
        for i in range(1, len(prices)):
            if prices[i]<low:
                low = prices[i]
            else:
                maximum = max(maximum, prices[i]-low)    
        return maximum

a = Solution()
prices = [7,1,5,3,6,4]
ans = a.maxProfit(prices)
print(ans)
class Solution(object):
    def containsDuplicate(self, nums):
        """
        :type nums: List[int]
        :rtype: bool
        """
        nums.sort()
        for i in range(len(nums)):
            if nums[i]==nums[i+1]:
                return False
            else:
                return True

a = Solution()
nums = [1,2,3]
ans = a.containsDuplicate(nums)
print(ans)
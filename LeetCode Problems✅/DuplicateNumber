class Solution(object):
    def containsDuplicate(self, nums):
        """
        :type nums: List[int]
        :rtype: bool
        """
        freq = {}
        for i in range(len(nums)):
            if nums[i] not in freq:
                freq[nums[i]] = 1
            else:
                freq[nums[i]] += 1
        return any(v > 1 for v in freq.values())
a = Solution()
nums = [2,14,18,22]
ans = a.containsDuplicate(nums)
print(ans)